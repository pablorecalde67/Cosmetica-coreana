# --- General ---
PORT=3000
# URL publica donde queda deployado el servicio (Railway te la da al hacer deploy).
# Meta necesita descargar las fotos/videos desde una URL publica para poder publicarlos.
PUBLIC_BASE_URL=https://tu-servicio.up.railway.app

# --- WhatsApp (tu numero personal, login por QR una sola vez) ---
# Numero(s) al que se le manda el aviso "hay contenido nuevo, falta precio".
# Formato: codigo de pais + numero, sin +, sin espacios. Ej: 5491122334455
WHATSAPP_OWNER_NUMBER=5491122334455

# IDs de los chats/canales de WhatsApp que hay que escuchar (separados por coma).
# Se obtienen la primera vez desde los logs del servicio (imprime el JID de cada
# mensaje que le llega) o desde /whatsapp-setup una vez conectado.
WHATSAPP_MONITORED_CHATS=

# --- Meta (Instagram + Facebook) ---
# Graph API access token de larga duracion de una app de Meta for Developers,
# con permisos: pages_show_list, pages_read_engagement, pages_manage_posts,
# instagram_basic, instagram_content_publish.
META_ACCESS_TOKEN=
# ID de la pagina de Facebook "COCA".
META_PAGE_ID=
# ID de la cuenta de Instagram Business/Creator "COCA" (vinculada a esa pagina).
META_IG_USER_ID=

# Hashtags fijos que se agregan a cada publicacion (separados por coma, sin #).
COCA_HASHTAGS=COCA,KBeauty,SkincareTips,GlowUp,BeautyTok,Belleza,Skincare
