# --- General ---
PORT=3000
# URL publica donde queda deployado el servicio (Railway te la da al hacer deploy).
# Meta necesita descargar las fotos/videos desde una URL publica para poder publicarlos.
PUBLIC_BASE_URL=https://tu-servicio.up.railway.app

# --- WhatsApp (tu numero personal, login por QR una sola vez) ---
# Numero(s) al que se le manda el aviso "hay contenido nuevo, falta precio".
# Formato: codigo de pais + numero, sin +, sin espacios. Ej: 5491122334455
WHATSAPP_OWNER_NUMBER=5491122334455

# Opcional: si la dejas vacia, se procesan TODOS los chats/canales que le
# lleguen a ese WhatsApp. Si mas adelante queres limitarlo a canales
# puntuales, cargá aca sus IDs separados por coma (se ven en los logs del
# servicio, imprime uno por cada mensaje que recibe).
WHATSAPP_MONITORED_CHATS=

# Numeros de negocios (sin +, sin espacios, separados por coma) cuyo ESTADO
# de WhatsApp queres que se procese como si fuera un canal (ej: mayoristas
# que publican su stock diario ahi en vez de en un canal). El Estado de
# cualquier otro contacto NUNCA se toca, aunque esto quede vacio.
WHATSAPP_STATUS_SOURCES=

# --- Meta (Instagram) ---
# Token de USUARIO de larga duracion (60 dias) de una app de Meta for
# Developers, con permisos: pages_show_list, pages_read_engagement,
# instagram_basic, instagram_content_publish. El servicio calcula solo el
# token de la Pagina a partir de este en cada publicacion, asi no hay que
# ir a buscarlo/renovarlo a mano.
META_USER_TOKEN=
# ID de la pagina de Facebook vinculada a la cuenta de Instagram "COCA"
# (Instagram publica a traves del token de esa pagina, aunque ya no se
# publique nada en Facebook).
META_PAGE_ID=
# ID de la cuenta de Instagram Business/Creator "COCA" (vinculada a esa pagina).
META_IG_USER_ID=

# Hashtags fijos que se agregan a cada publicacion (separados por coma, sin #).
COCA_HASHTAGS=COCA,KBeauty,SkincareTips,GlowUp,BeautyTok,Belleza,Skincare

# --- Pagina publica /piel: analisis de piel con IA + venta automatica ---

# API key de Anthropic (se genera en https://console.anthropic.com) usada
# solo para describir la piel de la selfie y elegir productos. La selfie
# jamas se guarda en disco ni en la base de datos: se usa en memoria para
# esta llamada y se descarta.
ANTHROPIC_API_KEY=
# Modelo de IA a usar (tiene que soportar imagenes). Dejalo asi salvo que
# quieras cambiarlo.
AI_MODEL=claude-sonnet-5

# Alias de Mercado Pago / CBU para que la clienta transfiera, se muestra
# recien al final del flujo, despues de que acepto el descargo de
# responsabilidad y confirmo el pedido.
TRANSFER_ALIAS=coca.beauty.mp
TRANSFER_HOLDER_NAME=
