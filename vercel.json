{
  "projectName": "K-Beauty CDE",
  "buildCommand": "echo 'Static site - no build needed'",
  "outputDirectory": "docs",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/tienda-simple.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
