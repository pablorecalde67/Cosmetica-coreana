# ============================================================
# KBEAUTYCDE - CONFIGURACIÓN DE APIs EXTERNAS
# ============================================================
# Copia este archivo a .env y rellena los valores reales

# SERVIDOR
NODE_ENV=production
PORT=3000
APP_URL=https://kbeautycde.com

# ============================================================
# INSTAGRAM GRAPH API
# ============================================================
# Obtén estos valores en: https://developers.facebook.com
# 1. Crea una app de Facebook
# 2. Agrega Instagram as a Product
# 3. Obtén Instagram Business Account ID
# 4. Genera Long-Lived Access Token

INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id_here

# ============================================================
# WHATSAPP BUSINESS API
# ============================================================
# Obtén estos valores en: https://developers.facebook.com/docs/whatsapp
# 1. Configura WhatsApp Business Account
# 2. Obtén Business Phone ID
# 3. Genera Access Token

WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_BUSINESS_PHONE_ID=your_whatsapp_phone_id_here
# Lista de números para alertas (separados por coma, formato internacional: +5491234567890)
WHATSAPP_CONTACTS=+595972020202,+5491234567890

# ============================================================
# TIKTOK API
# ============================================================
# Obtén en: https://developer.tiktok.com
# (Requiere aprobación manual de TikTok para acceso API)

TIKTOK_ACCESS_TOKEN=your_tiktok_access_token_here
TIKTOK_BUSINESS_ACCOUNT_ID=your_tiktok_account_id_here

# ============================================================
# GOOGLE ANALYTICS 4
# ============================================================
# Obtén en: https://analytics.google.com
# 1. Crea propiedad GA4
# 2. Obtén Measurement ID
# 3. Crea Data Stream y obtén API Secret

GA4_MEASUREMENT_ID=your_ga4_measurement_id_here
GA4_API_SECRET=your_ga4_api_secret_here

# ============================================================
# FACEBOOK PIXEL
# ============================================================
# Obtén en: https://business.facebook.com/pixels
# 1. Crea o selecciona pixel
# 2. Obtén Pixel ID
# 3. Genera Access Token

FACEBOOK_PIXEL_ID=your_facebook_pixel_id_here
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token_here

# ============================================================
# SUPABASE (Base de datos)
# ============================================================
# Opcional: para almacenar órdenes, usuarios, etc.

SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here

# ============================================================
# SENDGRID (Email marketing)
# ============================================================
# Opcional: para emails de confirmación y newsletter

SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@kbeautycde.com

# ============================================================
# CLOUDINARY (Almacenamiento de imágenes)
# ============================================================
# Para procesar y almacenar imágenes de productos

CLOUDINARY_CLOUD_NAME=your_cloudinary_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# ============================================================
# STRIPE (Pagos)
# ============================================================
# Para procesar pagos con tarjeta

STRIPE_PUBLIC_KEY=pk_live_your_stripe_key_here
STRIPE_SECRET_KEY=sk_live_your_stripe_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ============================================================
# SLACK (Notificaciones)
# ============================================================
# Para recibir alertas de órdenes, errores, etc.

SLACK_WEBHOOK_URL=your_slack_webhook_url_here
SLACK_CHANNEL=kbeauty-alerts
