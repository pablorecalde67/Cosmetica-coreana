# Production Environment Configuration
# Copy this to .env and fill in the actual values before deployment

# ============ SERVER ============
NODE_ENV=production
PORT=3000

# ============ ADMIN ============
ADMIN_TOKEN=your-secure-admin-token-here-change-in-production

# ============ PAYMENT GATEWAYS ============
STRIPE_PUBLIC_KEY=pk_live_your_stripe_key
STRIPE_SECRET_KEY=sk_live_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# ============ SHIPPING ============
ANDREANI_API_KEY=your_andreani_api_key
ANDREANI_CONTRACT=your_andreani_contract
SHIPPO_API_KEY=your_shippo_api_key

# ============ ANALYTICS ============
GOOGLE_ANALYTICS_ID=G-your-ga4-id
GOOGLE_SEARCH_CONSOLE_TOKEN=your_gsc_token
FACEBOOK_PIXEL_ID=your_facebook_pixel_id
TIKTOK_PIXEL_ID=your_tiktok_pixel_id

# ============ EMAIL & MARKETING ============
SENDGRID_API_KEY=SG.your_sendgrid_key
MAILCHIMP_API_KEY=your_mailchimp_api_key
MAILCHIMP_LIST_ID=your_mailchimp_list_id

# ============ WHATSAPP ============
WHATSAPP_BOT_TOKEN=your_whatsapp_bot_token
WHATSAPP_PHONE=your_phone_number_id

# ============ SEO & SITE ============
SITE_TITLE=K-Beauty CDE · Cosmética Coreana
SITE_DESCRIPTION=Descubre los mejores productos K-Beauty con análisis de piel con IA
SITE_KEYWORDS=belleza coreana, k-beauty, skincare, cosmetica, ciudad del este
SITE_URL=https://kbeautycde.com

# ============ INSTAGRAM SCRAPING ============
INSTAGRAM_BUSINESS_ACCOUNT=your_instagram_business_account
INSTAGRAM_API_TOKEN=your_instagram_api_token

# ============ DATABASE ============
# If using external database instead of JSON files
# DATABASE_URL=mongodb://user:pass@host/dbname

# ============ CDN & STORAGE ============
# For image uploads and file storage
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret
# AWS_S3_BUCKET=your_bucket_name
# AWS_REGION=us-east-1

# ============ MONITORING & LOGGING ============
SENTRY_DSN=your_sentry_dsn_for_error_tracking
LOG_LEVEL=info

# ============ SECURITY ============
# CORS settings
CORS_ORIGIN=https://kbeautycde.com
CORS_CREDENTIALS=true

# ============ DEPLOYMENT ============
HEROKU_APP_NAME=your-app-name
ENVIRONMENT=production
